# API Mode: 'http' connects to Spring Boot Auth Service, 'fake' uses mock in-browser adapter
VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:8081/api/v1

# Optional auth key kept for future Clerk integration.
VITE_CLERK_PUBLISHABLE_KEY=

# Required to render the ArcGIS map locally and in production.
VITE_ARCGIS_API_KEY=
